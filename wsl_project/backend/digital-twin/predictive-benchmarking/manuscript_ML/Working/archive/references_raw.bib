	file = {Full Text PDF:C\:\\Users\\dhani\\Zotero\\storage\\BB4V5TP6\\Joo and Han - 2021 - An Evidence of Distributed Trust in Blockchain-Based Sustainable Food Supply Chain.pdf:application/pdf},
